{
  "manifest_version": 3,
  "name": "Reply Forge",
  "version": "0.1.0",
  "description": "AI-powered reply assistant for X",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://x.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ]
    }
  ]
}